#!/usr/bin/env bash
set -euo pipefail

readonly PWM_CONTROLLERS=(febd0030 fd8b0030 febf0030 febe0000)

for address in "${PWM_CONTROLLERS[@]}"; do
    chips=(/sys/devices/platform/"${address}.pwm"/pwm/pwmchip*)
    if [[ ${#chips[@]} -ne 1 || ! -d "${chips[0]}" ]]; then
        echo "Expected one PWM controller for ${address}, found ${#chips[@]}" >&2
        exit 1
    fi
    chip="${chips[0]}"
    if [[ ! -d "${chip}/pwm0" ]]; then
        printf '0' > "${chip}/export"
        for _ in {1..100}; do
            [[ -d "${chip}/pwm0" ]] && break
            sleep 0.01
        done
    fi
    [[ -d "${chip}/pwm0" ]] || { echo "Failed to export ${chip}/pwm0" >&2; exit 1; }
    chmod 0666 "${chip}/export" "${chip}/unexport" \
        "${chip}/pwm0/enable" "${chip}/pwm0/period" \
        "${chip}/pwm0/duty_cycle" "${chip}/pwm0/polarity"
done

# The installed YAML is copied from the same defaults used by Python. This
# reads its plain scalar bank selector, not an independently maintained pin.
selector=${MHSEALS_MOSFET_CHIP:-$(awk '$1 == "mosfet_chip:" {print $2}' /usr/local/share/mhseals/hardware-default.yaml)}
if [[ "$selector" =~ ^gpio[0-9]+$ ]]; then
    matches=()
    for label in /sys/bus/gpio/devices/gpiochip*/label; do
        [[ -f "$label" ]] || continue
        if [[ "$(<"$label")" == "$selector" ]]; then
            directory=${label%/label}
            matches+=("/dev/${directory##*/}")
        fi
    done
    [[ ${#matches[@]} -eq 1 ]] || { echo "Expected one GPIO bank $selector" >&2; exit 1; }
    selector=${matches[0]}
fi
[[ "$selector" =~ ^/dev/gpiochip[0-9]+$ && -c "$selector" ]] || {
    echo "Invalid or missing MOSFET GPIO device: $selector" >&2; exit 1;
}
chmod 0666 "$selector"
