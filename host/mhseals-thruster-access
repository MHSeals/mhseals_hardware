#!/usr/bin/env bash
set -euo pipefail

# The installed YAML is copied from the same defaults used by Python; the PWM
# addresses (pwm_chips globs, pwm_channels) and the MOSFET bank come only from it.
# --print shows what was parsed and exits (the tests check it against Python).
readonly CONFIG=${MHSEALS_HARDWARE_DEFAULTS:-/usr/local/share/mhseals/hardware-default.yaml}
mapfile -t globs < <(awk '/^pwm_chips:/ {list = 1; next}
    list && /^ *- / {sub(/^ *- */, ""); sub(/ *#.*/, ""); print; next} {list = 0}' "$CONFIG")
read -ra channels < <(awk '/^pwm_channels:/ {sub(/#.*/, ""); gsub(/[^0-9]+/, " "); print}' "$CONFIG") || true
[[ ${#globs[@]} -gt 0 && ${#globs[@]} -eq ${#channels[@]} ]] || {
    echo "Expected matching pwm_chips and pwm_channels in $CONFIG" >&2; exit 1;
}
bank=$(awk '$1 == "mosfet_chip:" {print $2}' "$CONFIG")
if [[ ${1:-} == --print ]]; then
    printf '%s\n' "${globs[@]}" "${channels[*]}" "$bank"; exit 0
fi

for i in "${!globs[@]}"; do
    # shellcheck disable=SC2206  # the glob must expand
    chips=(${globs[i]})
    if [[ ${#chips[@]} -ne 1 || ! -d "${chips[0]}" ]]; then
        echo "Expected one PWM controller for ${globs[i]}, found ${#chips[@]}" >&2
        exit 1
    fi
    chip="${chips[0]}"
    pwm="${chip}/pwm${channels[i]}"
    if [[ ! -d "$pwm" ]]; then
        printf '%s' "${channels[i]}" > "${chip}/export"
        for _ in {1..100}; do
            [[ -d "$pwm" ]] && break
            sleep 0.01
        done
    fi
    [[ -d "$pwm" ]] || { echo "Failed to export $pwm" >&2; exit 1; }
    chmod 0666 "${chip}/export" "${chip}/unexport" \
        "${pwm}/enable" "${pwm}/period" "${pwm}/duty_cycle" "${pwm}/polarity"
done

selector=$bank
if [[ "$selector" =~ ^gpio[0-9]+$ ]]; then
    matches=()
    for label in /sys/bus/gpio/devices/gpiochip*/label; do
        [[ -f "$label" ]] || continue
        if [[ "$(<"$label")" == "$selector" ]]; then
            directory=${label%/label}
            matches+=("/dev/${directory##*/}")
        fi
    done
    [[ ${#matches[@]} -eq 1 ]] || { echo "Expected one GPIO bank $selector" >&2; exit 1; }
    selector=${matches[0]}
fi
[[ "$selector" =~ ^/dev/gpiochip[0-9]+$ && -c "$selector" ]] || {
    echo "Invalid or missing MOSFET GPIO device: $selector" >&2; exit 1;
}
chmod 0666 "$selector"
