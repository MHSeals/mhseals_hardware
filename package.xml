<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mhseals_hardware</name>
  <version>0.0.0</version>
  <description>Pico serial thruster control for the MHS Seals boat</description>
  <maintainer email="lunarzDev@outlook.com">MHS Seals</maintainer>
  <license>GPL-3.0</license>

  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>mhseals_nav</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
